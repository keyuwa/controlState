 // EPS Commands
 pub const EPS_BATTERY: &[u8] = &[SIM_EPS_ID, 0x00];
+pub const SIM_EPS_ADDR_HEATER: u8 = 0x02;
 
+/// Build an EPS heater set command: [SIM_EPS_ID, 0x02, mode]
+/// mode = 0 switches the heater off, any value > 0 switches it on.
+pub fn eps_set_heater(mode: u8) -> Vec<u8> {
+    vec![SIM_EPS_ID, SIM_EPS_ADDR_HEATER, mode]
+}
 
