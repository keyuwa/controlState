{
  "scenario_id": "condition_queue_disabled",
  "description": "任务条件改变（地面队列禁用即拒绝受理）：禁用队列后提交应被拒，状态不变",
  "policy_ids": [
    "QUEUE-1"
  ],
  "initial_state": {
    "queue": "ENABLED",
    "heater": 0
  },
  "steps": [
    {
      "step_id": "s1",
      "action": "disable_queue"
    },
    {
      "step_id": "s2",
      "action": "issue_command",
      "command": "/SERVICE-EPS/SetHeater",
      "args": {
        "Mode": 1
      },
      "timeout": 10
    },
    {
      "step_id": "s3",
      "action": "wait",
      "seconds": 1
    },
    {
      "step_id": "s4",
      "action": "release_queue"
    },
    {
      "step_id": "s5",
      "action": "query_eps"
    },
    {
      "step_id": "s6",
      "action": "read_state"
    }
  ],
  "expected": {
    "heater": 0,
    "queue": "ENABLED",
    "verdict": "pass",
    "policy_id": "QUEUE-1"
  }
}
