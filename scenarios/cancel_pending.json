{
  "scenario_id": "cancel_pending",
  "description": "取消待执行操作：阻塞队列后提交，reject 取消，再放行，加热器应保持关闭",
  "policy_ids": [
    "QUEUE-2",
    "EXP-1"
  ],
  "initial_state": {
    "queue": "ENABLED",
    "heater": 0
  },
  "steps": [
    {
      "step_id": "s1",
      "action": "hold_queue"
    },
    {
      "step_id": "s2",
      "action": "issue_command",
      "command": "/SERVICE-EPS/SetHeater",
      "args": {
        "Mode": 1
      },
      "timeout": 5
    },
    {
      "step_id": "s3",
      "action": "cancel_pending"
    },
    {
      "step_id": "s4",
      "action": "release_queue"
    },
    {
      "step_id": "s5",
      "action": "wait",
      "seconds": 2
    },
    {
      "step_id": "s6_pre",
      "action": "query_eps"
    },
    {
      "step_id": "s6",
      "action": "read_state"
    }
  ],
  "expected": {
    "heater": 0,
    "queue": "ENABLED",
    "verdict": "pass",
    "policy_id": "EXP-1"
  }
}
